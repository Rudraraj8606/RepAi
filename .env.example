# Copy to .env and fill in.  (cp .env.example .env)
ANTHROPIC_API_KEY=your-key-here

# App database (matches docker-compose.yml). For a hosted Postgres
# (Neon, Supabase, Render...) paste its connection string here instead.
DATABASE_URL=postgresql+psycopg://repai:repai@localhost:5432/repai

# Optional: run pytest against real Postgres instead of temp SQLite files.
# MUST be a different database from DATABASE_URL -- tests wipe it.
TEST_DATABASE_URL=postgresql+psycopg://repai:repai@localhost:5432/repai_test
